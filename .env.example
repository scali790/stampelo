# =============================================================================
# Stampelo — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# ─── APPLICATION ──────────────────────────────────────────────────────────────
# Public base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=https://www.stampelo.ch
# Node environment
NODE_ENV=production

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled endpoint for serverless)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/stampelo?sslmode=require

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend API key for email magic links (get at https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Admin bootstrap: the first user to sign in with this email gets admin role
ADMIN_EMAIL=your-admin-email@example.com

# ─── STRIPE ───────────────────────────────────────────────────────────────────
# Stripe secret key (sk_live_... for production, sk_test_... for testing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe publishable key (exposed to frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Stripe webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── STORAGE (Vercel Blob) ────────────────────────────────────────────────────
# Vercel Blob read/write token (auto-injected by Vercel when Blob is enabled)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
# Base URL of your Vercel Blob store (shown in Vercel Dashboard → Storage)
BLOB_BASE_URL=https://your-store.public.blob.vercel-storage.com

# ─── EMAIL ────────────────────────────────────────────────────────────────────
# Resend API key is shared with AUTH above.
# Sender address for transactional emails
EMAIL_FROM=noreply@stampelo.ch

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# See ADMIN_EMAIL above — no separate admin secret needed.
# To add additional admins: UPDATE users SET role = 'admin' WHERE email = '...'
